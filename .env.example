# PostgreSQL (used by docker-compose.yml, backend, and Better Auth)
POSTGRES_USER=workshop
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_DB=workshop
DATABASE_URL=postgres://workshop:CHANGE_ME_LOCAL_DEV_PASSWORD@127.0.0.1:5432/workshop
BETTER_AUTH_DB_URL=postgres://workshop:CHANGE_ME_LOCAL_DEV_PASSWORD@127.0.0.1:5432/workshop

# Better Auth & Runtime facilitator/admin control tokens (never commit real secrets)
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET_MIN_32_CHARS
BETTER_AUTH_URL=http://localhost:3000
FACILITATOR_TOKEN=CHANGE_ME_FACILITATOR_TOKEN
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
DEMO_ENABLED=true

# Backend HTTP/WS listener and CORS
BIND_ADDR=127.0.0.1:3001
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
